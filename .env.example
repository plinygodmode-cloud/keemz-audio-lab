# Public website origin. Must match your deployed Vercel domain.
SITE_URL=https://keemzaudiolab.vercel.app

# Paymob Egypt — use TEST credentials first. Never put secret keys in site-config.js.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
PAYMOB_CITY=Cairo
PAYMOB_STATE=Cairo
PAYMOB_POSTAL_CODE=00000

# Used to sign the order data carried through the Paymob callback.
PAYMENT_SIGNING_SECRET=
DOWNLOAD_TOKEN_SECRET=

# Resend transactional email (verify your sending domain first).
RESEND_API_KEY=
EMAIL_FROM=Keemz Audio Lab <verified-sender@your-domain.com>
CONTACT_TO_EMAIL=

# Sample catalogue and private download storage.
# Product prices are in the smallest currency unit: piastres for EGP.
# Keep PRODUCTS_JSON=[] until you add real products and real pack files.
PRODUCTS_JSON=[]
# Map each product ID to its object key in your PRIVATE Cloudflare R2 bucket.
DOWNLOAD_OBJECTS_JSON={}

# Private Cloudflare R2 bucket credentials for signed, expiring download links.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
