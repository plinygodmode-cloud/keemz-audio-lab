# ============================================================================
# KEEMZ AUDIO LAB — environment variables
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployment.
#
# Never commit real values. Never put these in assets/site-config.js.
# ============================================================================

# --- Site -------------------------------------------------------------------
# Exact HTTPS origin of the deployed site (no trailing slash). Used for Paymob
# callbacks, download emails and origin validation.
SITE_URL=https://keemzaudiolab.vercel.app

# Extra browser origins allowed to call the JSON APIs, comma separated.
# Useful for preview deployments; leave empty in production.
ALLOWED_ORIGINS=

# --- Paymob (Egypt / KSA / UAE / Oman) --------------------------------------
# Start with TEST credentials. PAYMOB_REGION selects the API + checkout host:
#   eg -> accept.paymob.com + eg.checkout.paymob.com
#   ksa -> ksa.paymob.com + ksa.checkout.paymob.com
#   uae -> uae.paymob.com + uae.checkout.paymob.com
#   om  -> oman.paymob.com + om.checkout.paymob.com
PAYMOB_REGION=eg
PAYMOB_BASE_URL=https://accept.paymob.com
# Optional override for the hosted checkout origin.
PAYMOB_CHECKOUT_URL=

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
PAYMOB_COUNTRY=EG
PAYMOB_CITY=Cairo
PAYMOB_STATE=Cairo
PAYMOB_POSTAL_CODE=00000

# --- Signing secrets --------------------------------------------------------
# Generate two independent values: `openssl rand -hex 32`
# PAYMENT_SIGNING_SECRET signs order references and the payment-return token.
# DOWNLOAD_TOKEN_SECRET signs the expiring download links.
PAYMENT_SIGNING_SECRET=
DOWNLOAD_TOKEN_SECRET=
# How long a download link stays valid (hours). Default 168 (7 days), max 720.
DOWNLOAD_LINK_TTL_HOURS=168

# --- Order store (required for fulfilment / idempotency) --------------------
# Any Upstash-compatible Redis REST endpoint works. Vercel KV exposes
# KV_REST_API_URL / KV_REST_API_TOKEN automatically once the integration is
# added to the project. Without it, checkout is disabled in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names used by Upstash directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Local development only: allow the in-memory store when no Redis is set.
# Never enable this in production — orders would not survive a cold start.
ALLOW_EPHEMERAL_STORE=

# --- Email (Resend) ---------------------------------------------------------
# Verify your sending domain in Resend before going live.
RESEND_API_KEY=
EMAIL_FROM=Keemz Audio Lab <orders@your-domain.com>
EMAIL_REPLY_TO=
# Inbox that receives project inquiries.
CONTACT_TO_EMAIL=
# Optional copy of every delivery email, for your own records.
DELIVERY_BCC_EMAIL=
# Comma-separated allowlist for the inquiry form's service field.
# Defaults to: Beat production, Sound design, Mixing & mastering,
#              Stem separation, Custom sample pack, Other / collaboration
CONTACT_SERVICES=

# --- Spam protection (optional) --------------------------------------------
# Pair with `turnstileSiteKey` in assets/site-config.js.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# --- Catalogue --------------------------------------------------------------
# Product prices are integers in the smallest currency unit (piastres for EGP).
# Keep PRODUCTS_JSON=[] until you have real packs and real files.
PRODUCTS_JSON=[]
# Map each product id to its object key inside the PRIVATE R2 bucket.
DOWNLOAD_OBJECTS_JSON={}

# --- Cloudflare R2 (private bucket) ----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Seconds a signed R2 URL stays valid (30–900). Default 120.
R2_SIGNED_URL_SECONDS=120

# --- Diagnostics (optional) -------------------------------------------------
# When set, GET /api/health?token=VALUE returns the list of missing variables
# and catalogue warnings. Without it, /api/health only returns booleans.
HEALTH_TOKEN=
